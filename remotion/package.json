{
  "name": "podcast-clipper-captions",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project that renders CapCut-style animated captions as a transparent overlay",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Captions out/captions.webm --props=sample.json --codec=vp8 --image-format=png --pixel-format=yuva420p"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/google-fonts": "4.0.250",
    "@remotion/layout-utils": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
