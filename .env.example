# ==============================================================================
# AutoClip Studio — Environment Configuration
# ==============================================================================

# Google Gemini API Key (Obrigatória para cortes inteligentes com IA e metadados)
# Obtenha sua chave em: https://aistudio.google.com/
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Modelo principal do Gemini para geração estruturada
# Opções comuns: gemini-3.8-flash, gemini-flash-latest, gemini-3.5-flash-lite
GEMINI_MODEL="gemini-3.8-flash"

# Modelos de contingência/fallback caso o principal atinja quota ou indisponibilidade
GEMINI_FALLBACK_MODELS="gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite"

# (Opcional) Vercel AI Gateway API Key (se utilizar o gateway da Vercel)
# AI_GATEWAY_API_KEY=""

# (Opcional) URL do servidor de desenvolvimento do Vite (para HMR no PyWebView)
# VITE_DEV_URL="http://localhost:5173"

# (Opcional) Ativar DevTools e modo de depuração no PyWebView (true/false)
# AUTOCLIP_DEBUG="false"

# (Opcional) Caminho padrão para imagem de overlay (moldura/marca d'água 16:9) em clipes longos
# DEFAULT_LONG_CLIP_OVERLAY="assets/overlays/frame.png"

# AssemblyAI API Key (Para transcrição rápida e de altíssima precisão na nuvem)
# Obtenha sua chave em: https://www.assemblyai.com/
ASSEMBLY_AI_API_KEY="sua_chave_assemblyai_aqui"

YOUTUBE_CLIENT_SECRET = ''